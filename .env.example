# Telegram Bot Credentials (用于本地与告警机器人交互)
TG_BOT_TOKEN=""
TG_CHAT_ID=""

# Cloudflare DNS API Credentials (用于本地自动维护与轮换二级伪装域名)
CF_API_TOKEN=""
CF_ZONE_ID=""

# AWS Lightsail API Credentials (用于本地一键换绑 Lightsail IP)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# 默认初始云厂商用户名 (例如 aws debian 默认是 admin，RackNerd 默认是 root)
DEFAULT_CLOUD_USER="admin"

# GitHub Personal Access Token (用于服务器端触发 GitHub Actions 云端扫描)
GH_TOKEN=""

# 🛡️ 零密钥安全网关 (Cloudflare Worker 代理，配置后服务器磁盘将实现 0 凭据)
# GATEWAY_URL="https://snack-gateway.your-subdomain.workers.dev"
# GATEWAY_AUTH_KEY="your_custom_auth_key"

# 🌐 全局界面与 Telegram 通知语言 (zh = 简体中文, en = English)
CNSR_LANG="zh"
